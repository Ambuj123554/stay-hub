<%layout("/layouts/boilerplate")%>
<style>
    .bill {
        background: white;
        border: 2px solid #000;
        padding: 20px;
        margin: 20px 0;
    }
    .bill-header {
        text-align: center;
        border-bottom: 2px solid #000;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }
    .bill-details {
        margin: 15px 0;
    }
    .bill-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    .bill-table th, .bill-table td {
        border: 1px solid #000;
        padding: 8px 12px;
        text-align: left;
    }
    .bill-table th {
        background-color: #f0f0f0;
    }
    .bill-footer {
        border-top: 2px solid #000;
        padding-top: 15px;
        margin-top: 20px;
    }
    @media print {
        .no-print { display: none !important; }
    }
</style>

<div class="row mt-3">
    <div class="col-10 offset-1">
        <div class="bill">
            <div class="bill-header">
                <h2>STAY HUB</h2>
                <p>Hotel Booking Services</p>
                <h4>BOOKING BILL</h4>
            </div>
            
            <div class="row bill-details">
                <div class="col-md-6">
                    <strong>Bill To:</strong><br>
                    <%=booking.customerName%><br>
                    Customer ID: <%=booking.customer._id%><br>
                </div>
                <div class="col-md-6 text-end">
                    <strong>Bill Details:</strong><br>
                    Bill No: BILL-<%=booking._id.toString().slice(-8).toUpperCase()%><br>
                    Booking ID: <%=booking._id%><br>
                    Date: <%=new Date().toLocaleDateString("en-IN")%><br>
                </div>
            </div>
            
            <table class="bill-table">
                <tr>
                    <th colspan="2">Property Information</th>
                </tr>
                <tr>
                    <td><strong>Property Name</strong></td>
                    <td><%=booking.listing.title%></td>
                </tr>
                <tr>
                    <td><strong>Location</strong></td>
                    <td><%=booking.listing.location%>, <%=booking.listing.country%></td>
                </tr>
                <tr>
                    <td><strong>Property Owner</strong></td>
                    <td><%=booking.listing.owner.username%></td>
                </tr>
            </table>
            
            <table class="bill-table">
                <tr>
                    <th colspan="2">Booking Information</th>
                </tr>
                <tr>
                    <td><strong>Check-in Date</strong></td>
                    <td><%=booking.checkInDate.toLocaleDateString("en-IN")%></td>
                </tr>
                <tr>
                    <td><strong>Check-out Date</strong></td>
                    <td><%=booking.checkOutDate.toLocaleDateString("en-IN")%></td>
                </tr>
                <tr>
                    <td><strong>Number of Days</strong></td>
                    <td><%=booking.numberOfDays%> days</td>
                </tr>
                <tr>
                    <td><strong>Number of Rooms</strong></td>
                    <td><%=booking.numberOfRooms%></td>
                </tr>
                <tr>
                    <td><strong>Room Type</strong></td>
                    <td><%=booking.roomType%></td>
                </tr>
            </table>
            
            <% 
                const basePrice = booking.listing.price;
                const roomMultipliers = {
                    'NON AC': 1.0,
                    'AC': 1.5,
                    'Premium': 2.0,
                    'Executive': 2.5,
                    'Presidential': 3.5
                };
                const multiplier = roomMultipliers[booking.roomType] || 1;
                const subtotal = basePrice * booking.numberOfDays * booking.numberOfRooms * multiplier;
                const tax = subtotal * 0.18; // 18% GST
                const total = subtotal + tax;
            %>
            
            <table class="bill-table">
                <tr>
                    <th>Description</th>
                    <th>Qty</th>
                    <th>Rate (&#8377;)</th>
                    <th>Amount (&#8377;)</th>
                </tr>
                <tr>
                    <td><%=booking.roomType%> Room - <%=booking.numberOfDays%> days</td>
                    <td><%=booking.numberOfRooms%></td>
                    <td><%=(basePrice * multiplier).toLocaleString("en-IN")%> per night</td>
                    <td><%=subtotal.toLocaleString("en-IN")%></td>
                </tr>
                <tr>
                    <td colspan="3"><strong>Sub Total</strong></td>
                    <td><strong>&#8377;<%=subtotal.toLocaleString("en-IN")%></strong></td>
                </tr>
                <tr>
                    <td colspan="3">GST (18%)</td>
                    <td>&#8377;<%=tax.toLocaleString("en-IN")%></td>
                </tr>
                <tr style="background-color: #f0f0f0;">
                    <td colspan="3"><strong>TOTAL AMOUNT</strong></td>
                    <td><strong>&#8377;<%=total.toLocaleString("en-IN")%></strong></td>
                </tr>
            </table>
            
            <div class="bill-footer">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Terms & Conditions:</strong></p>
                        <ul style="font-size: 12px;">
                            <li>Check-in: 2:00 PM | Check-out: 12:00 PM</li>
                            <li>Cancellation charges may apply</li>
                            <li>Valid ID proof required at check-in</li>
                            <li>Amount paid is non-refundable</li>
                        </ul>
                    </div>
                    <div class="col-md-6 text-end">
                        <p><strong>Payment Status: PAID</strong></p>
                        <p>Thank you for choosing Stay Hub!</p>
                        <br>
                        <p>_____________________</p>
                        <p>Authorized Signature</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center no-print mt-4">
            <button onclick="window.print()" class="btn btn-success">Print Bill</button>
            <a href="/listing" class="btn btn-primary">Back to Listings</a>
        </div>
    </div>
</div>