<%layout("/layouts/boilerplate")%>
<br>
<h1 class="col-6 offset-2">Login</h1>

<div class="row mt-3 ">
    <div class="col-8 offset-2 mb-5 ">
        <form action="/login" method="POST" class="needs-validation mb-4" novalidate>
            <div class="mb-4">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" type="text" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Username should be valid</div>
            </div>
            
            <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" type="password" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">password should be valid</div>
            </div>
            <button class="btn btn-success mb-5">Login</button>
            
        </form>
        <br><br><br><br>
    </div>
</div>
