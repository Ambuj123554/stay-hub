<%layout("/layouts/boilerplate")%>
<h1 class="col-6 offset-2">SignUp on Wonderlost</h1>
<br>
<div class="row mt-3 ">
    <div class="col-8 offset-2 mb-5 ">
        <form action="/signup" method="POST" class="needs-validation mb-4" novalidate>
            <div class="mb-4">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" type="text" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Username should be valid</div>
            </div>
            <div class="mb-4">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" id="email" type="email" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Email should be valid</div>
            </div>
            <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" type="password" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">password should be valid</div>
            </div>
            <button class="btn btn-success mb-5">SignUp</button>
        </form>
    </div>
</div>
