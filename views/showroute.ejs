<%layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h2><%=list.title%> </h2>
            
        </div>
    </div>
    <div class="row">
        <div class="col-6 offset-3 show-card">
            <div class="card listing-card">
                <div class="card col">
                    <img src="<%=list.image.url%>" class="card-img-top show-img" alt="listing_image">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        
                            <p class="card-text">Owned by-<i><%=list.owner.username%></i><br></p>
                            <p class="card-text"><%=list.description%><br></p>
                            <p class="card-text">&#8377 <%=list.price.toLocaleString("en-IN")%><br></p>
                            <p class="card-text"><%=list.location%><br></p>
                            <p class="card-text"><%=list.country%><br></p>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br>
    <%if(currUser){%>
        <%if(currUser._id.equals(list.owner._id)&&currUser){%>
            <div class="btns">
                <a href="/listing/<%=list._id%>/edit" class=" mb-3 btn btn-dark col-1 offset-3 edit-btn">Edit</a>
            
            
            <br>
                <form method="post" action="/listing/<%=list._id%>?_method=DELETE">
                    <button  class=" mb-3 btn btn-dark offset-5">Delete</button>
                </form>
            </div>
        <%}%>
    <%}%>
    
    

    <div class="col-8 offset-3">
        <hr>
        
        <%if(currUser){%>
            
                <h4>Leave a Review</h4>
                <form class="mb-3" action="/listing/<%=list._id%>/reviews" method="post" >
                    
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]"  placeholder="Enter comments" cols="30 " rows="5" id="comment" type="text" class="form-control" required></textarea>
                        <div class="invalid-feedback">Comments should be valid</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            
        <%}%>
        

        <%if(list.reviews.length>0){%>
            <hr>
        <div class="row">
        <p><b>All Reviews</b></p>
            <% for(review of list.reviews){%>
            
            <div class="card col-5 ms-5 mb-3">
                <div class="card-body">
                    <h5 class="card-title"><%= review.author.username%></h5>
                    <p class="starability-result card-text" data-rating="<%= review.rating%>"></p>
                    
                    <p class="card-text"> <%= review.comment%></p>
                </div>

                <%if(currUser){%>
                    <%if(currUser._id.equals(list.owner._id)&&currUser){%>
                        <form class="mb-4 mt-2" method="POST" action="/listing/<%=list._id%>/reviews/<%=review._id%>?method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    <%}%>
                <%}%>
            </div>
        <%}%>
        </div>
        <%}%>
        <!-- 🌍 Leaflet Map Section -->
<hr>
<h4 class="mt-4 mb-2">Where you'll be</h4>
<div id="map" style="height: 400px; width: 100%; border-radius: 10px;"></div>

    <script>
        // Check if coordinates are available
        const geo = <%- JSON.stringify(list.geometry || null) %>;
        let mapCenter = [28.6139, 77.2090];  // default to global center
        let zoomLevel = 5;

        const map = L.map('map').setView(mapCenter, zoomLevel);
        L.marker(mapCenter).addTo(map)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CartoDB'
        }).addTo(map);

        // If geometry exists, center map and add marker
        if (geo && geo.coordinates && geo.coordinates.length === 2) {
            const coords = [geo.coordinates[1], geo.coordinates[0]]; // [lat, lng]
            map.setView(coords, 13);
            L.marker(coords).addTo(map)
                .bindPopup('<h4><%= list.location %></h4><p>Exact location after your booking</p>')
                .openPopup();
        }
    </script>

    </div>
</body>
<script src="/js/map.js"></script>